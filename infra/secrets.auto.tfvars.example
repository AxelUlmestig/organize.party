# Copy to infra/secrets.auto.tfvars — tofu loads *.auto.tfvars on its own, and
# git ignores that name. Nothing here has a working default.

# Outbound mail. Without a real relay the worker starts and every send fails at
# the TLS handshake: it validates the certificate of any host that is not
# localhost. Bounce handling only works with SES, where the app learns about
# dead addresses from SES notifications over SNS.
smtp = {
  server   = "email-smtp.eu-north-1.amazonaws.com"
  port     = "587"
  login    = ""
  password = ""
}

# Mirrors database backups off the platform. Delete this block to keep backups
