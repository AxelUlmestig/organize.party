name:          generate-statecharts
version:       0.1.0.0
description:   Statechart SDK (Statechart definitions and build tool)
license:       AllRightsReserved
build-type:    Simple

flag lint
  description: lint
  manual:      True
  default:     False

flag prod
  description: prod
  manual:      True
  default:     False

executable generate-statecharts
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
      base            >=4.11     && <10
    , path
    , path-io
    , rio             >=0.1.12.0
    , statechart-sdk  >=0.1.1.1

  if flag(prod)
    ghc-options: -O2

  else
    ghc-options: -O0

  if flag(lint)
    ghc-options: -Werror

  default-language: GHC2021
