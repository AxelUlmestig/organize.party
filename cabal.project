packages:
  op-cache
  op-db
  op-webapi
  op-worker

package *
  ghc-options: -O2 -Wall

-- amazonka 2.0 (latest Hackage release) doesn't compile on GHC 9.8:
-- duplicate record fields in export lists became an error (GHC-97219).
-- Fixed on main but unreleased, so pin the git repo.
source-repository-package
  type: git
  location: https://github.com/brendanhay/amazonka.git
  tag: b562aa3f24845e34b95748daae671860017426be
  subdir:
    lib/amazonka
    lib/amazonka-core
    lib/services/amazonka-s3
    lib/services/amazonka-sso
    lib/services/amazonka-sts

