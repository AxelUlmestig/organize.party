cabal-version:      3.0
name:               op-aws
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       ../LICENSE
author:             Axel Ulmestig
maintainer:         axel.ulmestig@gmail.com
-- copyright:
build-type:         Simple
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Op.Aws
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.19.2.0
                    , amazonka
                    , amazonka-s3
                    , exceptions
                    , rio
                    , text
                    , time
    hs-source-dirs:   src
    default-language: GHC2021
    default-extensions:  BlockArguments
                       , DataKinds
                       , DeriveGeneric
                       , FlexibleContexts
                       , FlexibleInstances
                       , MultiParamTypeClasses
                       , NamedFieldPuns
                       , OverloadedRecordDot
                       , OverloadedStrings
                       , RecordWildCards
                       , QuasiQuotes
                       , TypeOperators
                       , NoImplicitPrelude
